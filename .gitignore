# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local env and secrets
.env
.env.*
!.env.example
*.local

# Cloudflare / wrangler
.wrangler/
.dev.vars

# Test and coverage output
coverage/
.vitest/

# Python tooling, used only to regenerate the data in src/engine
__pycache__/
*.py[cod]
.venv/
venv/

# Fixture artefacts regenerated by tools/make-fixture.py.
# The raw source and the stats JSON are committed on purpose: the tests
# compare against them and they are what makes the port verifiable without
# a Python install.
src/engine/__fixtures__/*.png
src/engine/__fixtures__/*.svg

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sw?

# OS
.DS_Store
Thumbs.db
